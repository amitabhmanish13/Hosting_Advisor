# --- Postgres ---
POSTGRES_USER=dhl
POSTGRES_PASSWORD=dhl
POSTGRES_DB=dhl_hosting_advisor

# --- Backend ---
# DATABASE_URL is overridden in docker-compose.yml to point at the postgres
# service; set it here only when running the backend outside Docker.
AUTH_PROVIDER=mock
OIDC_ISSUER=http://mock-idp:8100
OIDC_BROWSER_ISSUER=http://localhost:8100
OIDC_CLIENT_ID=dhl-hosting-advisor
OIDC_CLIENT_SECRET=dev-secret
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
JWT_SIGNING_KEY=change-me-to-a-random-string-before-any-real-deployment
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=dha_session
IPP_BASE_URL=http://localhost:4000
CORS_ORIGINS=["http://localhost:3000"]

# --- Switch to real Azure AD / Entra ID later, no code changes needed ---
# AUTH_PROVIDER=azuread
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>
# OIDC_BROWSER_ISSUER=https://login.microsoftonline.com/<tenant-id>
# OIDC_CLIENT_ID=<app-registration-client-id>
# OIDC_CLIENT_SECRET=<app-registration-client-secret>
# OIDC_REDIRECT_URI=https://<your-domain>/auth/callback

# --- Frontend (baked in at build time by Vite) ---
VITE_API_BASE_URL=http://localhost:8000
